{% liquid
  assign gallery_media = product.media | where: 'media_type', 'image'
%}

<div
  class="gn-slider"
  data-gallery-nest-slider
  data-product-id="{{ product.id }}"
  data-app-proxy-path="/apps/gallery-nest/slider-settings"
  hidden
>
  <script type="application/json" data-gallery-nest-media>
    [
      {%- for media in gallery_media -%}
        {
          "id": {{ media.id | json }},
          "alt": {{ media.alt | default: product.title | json }},
          "thumb": {{ media.preview_image | image_url: width: 180 | json }},
          "src": {{ media.preview_image | image_url: width: 900 | json }},
          "zoom": {{ media.preview_image | image_url: width: 1800 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-gallery-nest-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "mediaId": {{ variant.featured_media.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

{% schema %}
{
  "name": "GalleryNest slider",
  "target": "section",
  "stylesheet": "gallery-nest-slider.css",
  "javascript": "gallery-nest-slider.js",
  "settings": []
}
{% endschema %}
