<div
  class="gn-slider"
  data-gallery-nest-slider
  data-product-id="{{ product.id }}"
  data-app-proxy-path="/apps/gallery-nest/slider-settings"
  data-has-only-default-variant="{{ product.has_only_default_variant }}"
  hidden
>
  <script type="application/json" data-gallery-nest-media>
    [
      {%- for image in product.images -%}
        {
          "id": {{ image.id | json }},
          "alt": {{ image.alt | default: product.title | json }},
          "thumb": {{ image | image_url: width: 180 | json }},
          "src": {{ image | image_url: width: 900 | json }},
          "zoom": {{ image | image_url: width: 1800 | json }},
          "variantIds": [
            {%- for variant in image.variants -%}
              {{ variant.id | json }}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-gallery-nest-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "mediaId": {{ variant.featured_image.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

{% schema %}
{
  "name": "GalleryNest slider",
  "target": "section",
  "stylesheet": "gallery-nest-slider.css",
  "javascript": "gallery-nest-slider.js",
  "settings": []
}
{% endschema %}
